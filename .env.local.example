# ── Neon PostgreSQL ───────────────────────────────────────────────────────────
# Pooled connection (used by API routes at runtime)
DATABASE_URL="postgresql://USER:PASS@HOST/DB?sslmode=require&pgbouncer=true"
# Direct connection (used by Prisma migrations)
DATABASE_URL_UNPOOLED="postgresql://USER:PASS@HOST/DB?sslmode=require"

# ── Admin Auth ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET="replace_with_32_random_chars"
ADMIN_PASSWORD="choose_a_strong_password"

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ── Resend Email ──────────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxx"
# Showroom inbox that receives new lead notifications
RESEND_TO_EMAIL="showroom@example.com"
# Must be a verified domain/address in Resend
RESEND_FROM_EMAIL="noreply@yourdomain.com"
